  use std.mem.Arena

  let Blob = struct {
      tag:  i64
      size: i64
  }

  let Slot = struct {
      blob: *Blob
      next: *Slot
      key:  i64
  }

  let Table = struct {
      name:  str
      first: *Slot
      total: i64
      count: i64
  }

  fn makeBlob(a: Arena, tag: i64, size: i64) *Blob {
      var b = a.create(Blob)

      b.tag = tag
      b.size = size

      return b
  }

  fn makeSlot(a: Arena, tag: i64, size: i64, key: i64) *Slot {
      var s = a.create(Slot)

      s.blob = makeBlob(a, tag, size)
      s.key = key

      return s
  }

  fn sizeOf(s: *Slot) i64 {
      return s.blob.size
  }

  fn keyOf(s: *Slot) i64 {
      return s.key
  }

  /// Sizes two draft slots in staging space, keeps only the budget they imply, and
  /// stores the slot that actually survives. Staging is released before the table is
  /// handed back, so nothing measured here outlives the call.
  fn build(arena: Arena, name: str) *Table {
      var staging = arena.child()

      var table = arena.create(Table)

      table.name = arena.copy(name)
      table.total = 0
      table.count = 0

      var draft = makeSlot(staging, 1, 100, 7)
      var probe = makeSlot(arena, 2, 150, 9)

      var budget = sizeOf(draft) + sizeOf(probe)

      var kept = makeSlot(arena, 3, budget, 11)

      table.first = probe
      table.total = budget
      table.count = 2

      staging.destroy()

      return table
  }

  fn main(arena: Arena) i64 {
      var table = build(arena, "sessions")

      return sizeOf(table.first) + keyOf(table.first)
  }
