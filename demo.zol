import std.fs
import std.mem

type BadConfig = { line: u32 }
type ConfigError = fs.ReadError | BadConfig

fn load(store: *var mem.Store, path: []u8) Config | ConfigError {
    let text = fs.read_all(store, path) or return
    defer store.free(text)
    return parse(text) or return
}

pub fn main(store: *var mem.Store, args: [][]u8) u8 {
    let config = load(store, "zol.toml") or e {
        match e {
            fs.NotFound n     => log("no such file: {}", n.path)
            fs.Denied d       => log("cannot read: {}", d.path)
            fs.IsDirectory d  => log("{} is a directory", d.path)
            fs.ReadFailed r   => log("read failed on {}: {}", r.path, r.code)
            mem.OutOfMemory   => log("out of memory")
            BadConfig b       => log("bad config on line {}", b.line)
        }
        return 1
    }

    return run(config)
}
