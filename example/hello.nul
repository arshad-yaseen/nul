use std.mem.Arena

let Entry = struct {
    name: str
    size: i64
}

/// The scratch arena dies when this call does, so anything kept has to be copied into
/// the arena the caller handed down. Nothing here says how long a value lives.
fn record(arena: Arena, raw: str) *Entry {
    var scratch = arena.child()

    let trimmed = scratch.copy(raw)

    var entry = arena.create(Entry)

    entry.name = arena.copy(trimmed)
    entry.size = 1

    return entry
}
