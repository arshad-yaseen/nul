{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "nul",
      "camelcase": "Nul",
      "scope": "source.nul",
      "path": ".",
      "file-types": ["nul"],
      "injection-regex": "^nul$",
      "highlights": ["queries/highlights.scm"],
      "injections": ["queries/injections.scm"],
      "locals": ["queries/locals.scm"]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "description": "Nul grammar for tree-sitter",
    "authors": [
      {
        "name": "arshad",
        "email": "arshadpyaseen@gmail.com"
      }
    ]
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "kotlin": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
