// A union value is one of its members, stored as a tag and a payload. The tag
// is not something you can name or read.
//
// Three rules, and they are the whole feature.
//
// 1. Members are distinct types. `[]u8 | []u8` is refused, and so is
//    `[]u8 | Name` when `type Name = []u8`, because an alias is not a new
//    type. To carry two values of one underlying type, give each its own.
//
// 2. Order is part of the type, the way it is for a tuple. `A | B` and `B | A`
//    are no more the same type than `(A, B)` and `(B, A)` are. The first member
//    is the one that succeeded, and `or` splits there.
//
// 3. Unions flatten and never repeat. `(A | B) | C` is `A | B | C`, so aliases
//    compose. A union written with a repeat is a mistake and is refused.

type Meters = { value: f64 }            // rule 1, the honest cost
type Feet = { value: f64 }
type Length = Meters | Feet

fn parse(s: []u8) f64 | BadNumber {
    if s.len == 0 { return BadNumber }  // returning is just returning
    return to_f64(s)                    // no wrapper, so no coercion to learn
}

// What a signature permits is decided by membership, and by nothing else. A
// value fits a union that lists its type, and a union fits a union that
// lists every member it may hold. Order is identity, not a wall: `A | B` and
// `B | A` are distinct types, yet each fits where the other does, and what
// order changes is which member `or` splits first. The other direction is
// never free. A union gives a member back only through a branch that proves
// it, which is what the rest of this file is about.


// Inside a branch that has established which member a value holds, the value
// is that member. No cast, no unwrap, no second name for it.

fn use_it(xs: []i32) {
    let r = find(xs, 7)                 // r : i32 | none

    if r is i32 {
        report(r)                       // r : i32
    } else {
        report_missing(r)               // r : none, the complement narrows too
    }

    if r is not none {
        report(r)                       // r : i32
    }
}

// Narrowing applies to `let` bindings and parameters, never to `var`. Those
// cannot change between the test and the use, so there is no invalidation rule
// to hold in your head. Bind a `var` to a `let` first.
//
// `is` never binds. It re-types a name that already exists, which is why there
// is no capture syntax and nothing to shadow. Where there is no name to re-type,
// make one with `let`, or split the union with `or`.
//
// `is not T` narrows to everything but T. On a union of two that is the same as
// naming the other member, and on a wider one it is the only way to say it.

fn get(self: Value, key: []u8) Value | none {
    self is Object or return none       // statement form, for a guard
    return self.fields.get(key)         // self : Object for the rest of the body
}

// A branch that leaves narrows what follows it, the same way. After
// `if self is not Object { return none }` the rest of the body sees
// `self : Object`, which is the guard above written long.


// `e or f` is the first member of e, or else f. It is substitution,
// propagation, early exit, and handling, and it is the only one of those the
// language has.

let port = config.port or 8080          // substitute
let cfg = load(path) or return          // propagate, unchanged
let cfg = load(path) or e { log(e) }    // bind the rest and handle it
let job = queue.take() or break         // leave a loop
let name = user.name or "anonymous"

// On a union of more than two, `or` splits the first member from all the rest,
// so `e` below binds `Timeout | NotFound`.
let reply = fetch() or e {
    match e {
        Timeout => retry()
        NotFound => give_up()
    }
}

// `or` on a bool is ordinary logical or, because `true` is the first member of
// `true | false`, and the right side may be the first member or everything the
// left could be. One rule, not two. `and` and `not` are their own operators.


// There is no `try`, no `catch`, no `throw`, and no propagation you cannot see.
// An error is a type, a fallible function returns a union that includes it, and
// `or return` sends it up. Nothing is implicit.

type FileError = { path: []u8, code: i32 }
type BadSyntax = { line: u32 }
type Timeout

fn load(store: Store, path: []u8) Config | FileError | BadSyntax | Timeout {
    let text = read_file(store, path) or return
    defer store.free(text)

    if text.len == 0 { return BadSyntax.{ line: 0 } }
    return parse_config(text)
}

// `or return` works because the value already has a type the signature permits.
// There is no widening, no `From`, no error set inference, and no rule about
// which error converts to which. A failure the signature does not list is a
// compile error that names the type to add.

// Name the failure set once it is more than a member or two. A union flattens,
// so `Config | LoadError` is the type `load` already returns, spelled shorter,
// and a caller that only passes the failure up never names a member of it.

type LoadError = FileError | BadSyntax | Timeout

fn caller(store: Store) i32 | LoadError {
    let cfg = load(store, "zol.toml") or return
    return cfg.jobs
}

// The alias is the one place a new failure is added, and every `match` over it
// stops compiling until the new member has an arm.

fn report(store: Store) u8 {
    let cfg = load(store, "zol.toml") or e {
        match e {                       // e : LoadError, so three arms cover it
            FileError => log("cannot read {}", e.path)
            BadSyntax => log("bad syntax on line {}", e.line)
            Timeout => log("gave up waiting")
        }
        return 1
    }
    return use(cfg)
}

fn settle(store: Store) i32 {
    return load(store, "zol.toml") or 1  // handled here, so nothing leaves
}


// An arm labels a member, or several with `|`, and inside the arm the value
// is what the label proved, the way a branch that passed an `is` sees it. No
// arm binds a name: where the scrutinee has no name, make one with `let`,
// the same rule `is` follows. Exhaustive by counting: every member covered
// exactly once, so adding a member to a union shows you every match that
// needs a new arm, and an arm that cannot run is refused.

match shape {
    Circle => PI * shape.r * shape.r
    Rect => shape.w * shape.h
    Line => 0.0
}

let label = match reply {
    Config => "loaded"
    Timeout => "slow"
    NotFound => "missing"
}

// An alias arm covers the members it names, so a failure set handles as one
// arm and stays one name end to end. `else` covers what is left, and is the
// rest as a type rather than a blind default: one member left stands bare,
// several stay a union, so the rest can be handed on whole.

fn code(reply: Reply) u8 {
    return match reply {
        Config => 0
        else => classify(reply)         // reply : Timeout | NotFound
    }
}

// Arms that leave narrow what follows, the way any branch that leaves does.

fn settle(reply: Reply) Config {
    match reply {
        Timeout | NotFound => return Config.fallback()
        Config => {}
    }
    return reply                        // reply : Config
}


// A condition is a union, and asks whether it holds its first member.
if cond { } else if other { } else { }
if r is i32 { }
if r is i32 and r > 0 { }               // the narrowing holds across `and`
let y = if c { a } else { b }           // an expression, so arms share a type


loop { }                                // forever
loop cond { }                           // while
loop x in xs { }                        // over a sequence
loop i in 0..n { }                      // over indices

// `in` reaches a custom iterator too. Where the subject is not a slice or a
// range, `loop x in e` calls `e.next()`, which returns `T | none`. A type is
// iterable by having that one method, so there is no protocol to declare and
// no trait to implement.
loop job in queue { }

// A loop header never narrows, because `is` has no name to work on there.
// `or break` does the same job in the body, and names the value on the way.
loop {
    let job = queue.take() or break
    run(job)
}

// `else` runs when the loop ends on its own. `break` skips it, which is what
// makes a loop usable as an expression.
loop cond { } else { }
let found = loop x in xs {
    if pred(x) { break x }
} else {
    none
}

outer: loop r in rows {                 // labels, for the inner break
    loop c in r {
        if bad(c) { break :outer }
    }
}

// `break :outer x` leaves the labeled loop with a value. The `:` is what
// keeps a label apart from a value, so `break x` stays unambiguous.

break    continue    return

// `loop x in xs` binds x as a place, mutable exactly when the slice is []var T.


defer cleanup()                         // on every way out
errdefer e { undo(e) }                  // only when a non-first member leaves


