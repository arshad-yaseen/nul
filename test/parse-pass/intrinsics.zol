// The keyword is a primary expression, so the ordinary suffix chain reads
// the name, the type arguments, and the call.

fn cast(p: *var u8) *var i64 {
    return intrinsic.ptr_cast[i64](p)
}

fn nested(p: *var u8) *var i64 {
    return intrinsic.ptr_cast[i64](intrinsic.ptr_cast[u8](p))
}

fn as_an_argument(p: *var u8) i64 {
    return take(intrinsic.ptr_cast[i64](p))
}

fn take(p: *var i64) i64 {
    return 0
}
