error NotFound
error OutOfRange

fn read(store: Store, path: i64) !i64 {
    let value = try io.read_file(store, path)
    return value
}

fn fallback(store: Store) i64 {
    return read(store, 1) catch 0
}

fn handled(store: Store) {
    let value = read(store, 1) catch |e| {
        report(e)
    }
    _ = value
}

fn named() !i64 {
    let e = NotFound
    _ = e
    return OutOfRange
}

fn chained(store: Store) i64 {
    return read(store, 1) catch read(store, 2) catch 3
}
