fn defaults(opt: ?i64) i64 {
    let a = opt orelse 0
    let b = opt orelse a orelse 0
    return a + b
}

fn capture(opt: ?i64) i64 {
    if opt |v| {
        return v
    } else {
        return 0
    }
}

fn plain(opt: ?i64) {
    if opt |v| {
        _ = v
    }
    let nothing: ?i64 = null
    _ = nothing
}

fn walk(first: ?*var Cell) i64 {
    var total = 0
    var next = first
    while next |cell| {
        total = total + cell.value
        next = cell.next
    }
    return total
}

fn guard(opt: ?i64) i64 {
    let v = opt orelse {
        return 0
    }
    return v
}
