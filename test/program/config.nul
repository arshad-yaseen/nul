//! A server configuration: built, amended, validated, and measured.
//! Everything lives in arenas, and every problem found is recorded into a
//! collection that carries its own memory.

use std.mem.Arena

// limits the whole file agrees on

let kilobyte = 1024
let megabyte = kilobyte * 1024

pub let request_bytes_max: u32 = 8 * megabyte
pub let header_bytes_max: u32 = 64 * kilobyte
pub let routes_max: usize = 64
pub let name_length_max: usize = 48

let port_floor: u16 = 1024
let backlog_default: u32 = 128
let retry_ceiling: u32 = 6

/// Ports are a size the wire decides, and the alias keeps signatures honest.
pub type Port = u16

/// A route list is a chain of nodes in one arena.
pub type Routes = ?*var Route

// the shape of a configuration

pub struct Server {
    host: str
    port: Port
    backlog: u32
    reuse_address: bool
}

pub struct Timeouts {
    connect_ms: u32
    read_ms: u32
    write_ms: u32
}

pub struct Limits {
    requests: u32
    request_bytes: u32
    header_bytes: u32
}

pub struct Retry {
    attempts: u32
    delay_ms: u32
    exponential: bool
}

pub struct Route {
    path: str
    port: Port
    weight: u32
    next: Routes
}

/// The whole configuration: seven fields, one of them the arena every route
/// is allocated from, so adding a route asks the caller for nothing.
pub struct Config {
    arena: Arena
    name: str
    server: Server
    timeouts: Timeouts
    limits: Limits
    retry: Retry
    routes: Routes
    route_count: usize

    /// A route appended at the front. The chain and the config share one
    /// lifetime, because they share one arena.
    pub fn add_route(self: *var Config, path: str, port: Port, weight: u32) {
        var node = self.arena.create[Route]()
        node.path = path
        node.port = port
        node.weight = weight
        node.next = self.routes
        self.routes = node
        self.route_count = self.route_count + 1
    }

    /// The first route matching a path, walking the chain. Reading wants a
    /// read-only receiver: no copy of seven fields, no claim to mutate.
    pub fn find(self: *Config, path: str) Routes {
        var cursor = self.routes
        while cursor |route| {
            if route.path == path {
                return route
            }
            cursor = route.next
        }
        return null
    }

    /// The route at a position, counted from the front.
    pub fn at(self: *Config, index: usize) Routes {
        var cursor = self.routes
        var seen: usize = 0
        while cursor |route| {
            if seen == index {
                return route
            }
            seen = seen + 1
            cursor = route.next
        }
        return null
    }

    /// The heaviest route, or null on an empty chain.
    pub fn heaviest(self: *Config) Routes {
        var cursor = self.routes
        var best: Routes = null
        var best_weight: u32 = 0
        while cursor |route| {
            if route.weight > best_weight {
                best_weight = route.weight
                best = route
            }
            cursor = route.next
        }
        return best
    }
}

// problems, recorded into memory the collection already owns

pub struct Problem {
    code: u32
    penalty: u32
    next: ?*var Problem
}

/// The collection keeps the arena it was built from, so recording a problem
/// asks for nothing and can happen anywhere the collection can.
pub struct Problems {
    arena: Arena
    first: ?*var Problem
    count: usize
    penalty_total: u32

    pub fn init(arena: Arena) Problems {
        return .{ arena: arena, first: null, count: 0, penalty_total: 0 }
    }

    pub fn record(self: *var Problems, code: u32, penalty: u32) {
        var problem = self.arena.create[Problem]()
        problem.code = code
        problem.penalty = penalty
        problem.next = self.first
        self.first = problem
        self.count = self.count + 1
        self.penalty_total = self.penalty_total + penalty
    }

    pub fn worst(self: *Problems) u32 {
        var cursor = self.first
        var top: u32 = 0
        while cursor |problem| {
            if problem.penalty > top {
                top = problem.penalty
            }
            cursor = problem.next
        }
        return top
    }
}

// a generic box, for a value worth pinning down in an arena

pub struct Box[T] {
    value: T

    pub fn of(arena: Arena, value: T) *var Box[T] {
        var box = arena.create[Box[T]]()
        box.value = value
        return box
    }

    pub fn get(self: *Box[T]) T = self.value

    pub fn set(self: *var Box[T], value: T) {
        self.value = value
    }
}

/// A boxed value with its type read off the argument, no brackets written.
pub fn boxed[T](arena: Arena, value: T) *var Box[T] {
    return Box[T].of(arena, value)
}

// building

/// The defaults every configuration starts from. The template holds no
/// pointer and no arena, so `copy` will take it anywhere.
pub fn default_timeouts() Timeouts {
    return .{ connect_ms: 250, read_ms: 1000, write_ms: 1000 }
}

pub fn default_limits() Limits {
    return .{
        requests: 1000,
        request_bytes: request_bytes_max,
        header_bytes: header_bytes_max,
    }
}

pub fn default_retry() Retry {
    return .{ attempts: 3, delay_ms: 100, exponential: true }
}

/// A configuration in its own arena, defaults filled, no routes yet.
pub fn build_default(arena: Arena) *var Config {
    var config = arena.create[Config]()
    config.arena = arena
    config.name = "gateway"
    config.server = .{
        host: "0.0.0.0",
        port: 8080,
        backlog: backlog_default,
        reuse_address: true,
    }
    config.timeouts = default_timeouts()
    config.limits = default_limits()
    config.retry = default_retry()
    config.routes = null
    config.route_count = 0
    return config
}

/// The standard gateway: defaults plus the three routes every deployment has.
pub fn build_gateway(arena: Arena) *var Config {
    var config = build_default(arena)
    config.add_route("/health", 8081, 1)
    config.add_route("/metrics", 8081, 1)
    config.add_route("/api", 9000, 10)
    return config
}

/// A timeouts block copied into a config's own arena and stretched. `copy`
/// accepts `Timeouts` because it reaches no other memory.
pub fn slow_timeouts(config: *var Config, template: Timeouts) {
    var stretched = config.arena.copy(template)
    stretched.read_ms = stretched.read_ms * 4
    stretched.write_ms = stretched.write_ms * 4
    config.timeouts = stretched
}

// validating

/// A port below the floor is reserved for the system.
fn checked_port(port: Port) !Port {
    if port < port_floor {
        return error.PortReserved
    }
    return port
}

/// A name the dashboards can print: short, and never empty.
fn checked_name(name: str) !str {
    if name.len == 0 {
        return error.NameEmpty
    }
    if name.len > name_length_max {
        return error.NameTooLong
    }
    return name
}

/// How bad a validation failure is, as a penalty the report can add up.
fn penalty_of(err_code: u32) u32 {
    if err_code == 1 {
        return 25
    } else if err_code == 2 {
        return 10
    } else {
        return 50
    }
}

/// Walk the whole configuration and record what is wrong with it. The
/// problems collection allocates from its own arena; this function needs
/// none, and asks for none.
pub fn validate(config: *Config, problems: *var Problems) {
    checked_name(config.name) catch {
        problems.record(1, penalty_of(1))
    }

    checked_port(config.server.port) catch {
        problems.record(2, penalty_of(2))
    }

    if config.server.backlog == 0 {
        problems.record(3, penalty_of(3))
    }

    if config.limits.request_bytes > request_bytes_max {
        problems.record(4, penalty_of(4))
    }
    if config.limits.header_bytes > config.limits.request_bytes {
        problems.record(5, penalty_of(5))
    }

    if config.retry.attempts > retry_ceiling {
        problems.record(6, penalty_of(6))
    }
    if config.retry.exponential and config.retry.delay_ms == 0 {
        problems.record(7, penalty_of(7))
    }

    if config.route_count == 0 {
        problems.record(8, penalty_of(8))
    }
    if config.route_count > routes_max {
        problems.record(9, penalty_of(9))
    }

    var cursor = config.routes
    while cursor |route| {
        checked_port(route.port) catch |err| {
            if err == error.PortReserved {
                problems.record(10, penalty_of(10))
            }
        }
        if route.path.len == 0 {
            problems.record(11, penalty_of(11))
        }
        if route.weight == 0 {
            problems.record(12, penalty_of(12))
        }
        cursor = route.next
    }
}

/// True when the configuration would survive a deploy: no problem recorded,
/// or nothing worse than a warning.
pub fn deployable(config: *Config, arena: Arena) bool {
    var problems: Problems = Problems.init(arena.child())
    validate(config, &problems)
    if problems.count == 0 {
        return true
    }
    return problems.worst() < 25
}

// measuring, with scratch memory that dies on schedule

/// The total weight behind one port, using a scratch arena per route that is
/// reset each iteration, which is what `reset` is for.
pub fn weight_behind(config: *Config, port: Port, arena: Arena) u32 {
    var scratch = arena.child()
    var total: u32 = 0
    var cursor = config.routes
    while cursor |route| {
        var probe = scratch.create[Route]()
        probe.path = route.path
        probe.port = route.port
        probe.weight = route.weight
        probe.next = null
        if probe.port == port {
            total = total + probe.weight
        }
        scratch.reset()
        cursor = route.next
    }
    return total
}

/// The route count a fresh gateway would have, worked out in a child arena
/// destroyed the moment the number is known, well before this scope ends.
pub fn gateway_route_count(arena: Arena) usize {
    var work = arena.child()
    var config = build_gateway(work)
    let count = config.route_count
    work.destroy()
    return count
}

/// The port the busiest route listens on, or the server's own when there are
/// no routes at all.
pub fn busiest_port(config: *Config) Port {
    let top = config.heaviest() orelse {
        return config.server.port
    }
    return top.port
}

/// The name, or a stand-in when validation refuses it.
pub fn printable_name(config: *Config) str {
    return checked_name(config.name) catch "unnamed"
}

/// How full the route table is, in whole percent.
pub fn route_pressure(config: *Config) usize {
    let scaled = config.route_count * 100
    return scaled / routes_max
}

// a full run, end to end

/// Build, amend, validate, and measure one gateway. The number is a health
/// score: zero for a clean configuration, penalties added up otherwise.
pub fn audit(arena: Arena) u32 {
    var config = build_gateway(arena)
    config.add_route("/admin", 800, 2)

    slow_timeouts(config, default_timeouts())

    var problems: Problems = Problems.init(arena.child())
    validate(config, &problems)

    var score = problems.penalty_total
    if deployable(config, arena) == false {
        score = score + 100
    }

    let admin = config.find("/admin") orelse {
        return score + 1000
    }
    if admin.port < port_floor {
        score = score + 5
    }

    _ = config.at(0)
    _ = weight_behind(config, 8081, arena)
    _ = gateway_route_count(arena)
    _ = busiest_port(config)
    _ = printable_name(config)
    _ = route_pressure(config)

    let boxed_score = boxed(arena, score)
    boxed_score.set(boxed_score.get() + 1)
    return boxed_score.get() - 1
}

/// Where a whole program would start, if programs started yet: one root
/// arena, one audit, and the score as the exit code.
pub fn start() u32 {
    var arena = Arena.init()
    let score = audit(arena)
    if score > 255 {
        return 255
    }
    let narrow: u32 = score
    return narrow
}
