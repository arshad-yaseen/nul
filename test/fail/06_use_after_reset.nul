use std.mem.Arena

let Item = struct {
    weight: i64
}

/// The programmer places the reset. The compiler checks the placement, and this
/// one is one line too early.
fn weigh(arena: Arena) i64 {
    var scratch = arena.child()

    var item = scratch.create(Item)
    item.weight = 42

    scratch.reset()

    return item.weight
}
