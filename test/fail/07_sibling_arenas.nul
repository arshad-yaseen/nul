use std.mem.Arena

let Payload = struct {
    tag: i64
}

let Link = struct {
    to: *Payload
}

/// Siblings have no ordering between them. Neither outlives the other, so a
/// pointer either way is rejected.
fn cross(arena: Arena) {
    var first = arena.child()
    var second = arena.child()

    var link = first.create(Link)
    var payload = second.create(Payload)

    link.to = payload
}
