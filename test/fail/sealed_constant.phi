fn num() u32 {
    return 10
}

fn mixes() u32 {
    let a: u32 | u8 = num()
    let b: u64 = 2

    match a {
        u32 => return a + b
        u8 => {}
    }

    return 10
}

fn crosses() u32 {
    let b: u64 = 2
    let c: u32 = b
    return c
}

fn extracts() u8 {
    let a: u32 | u8 = 10
    let d: u8 = a
    return d
}
