type true
type false
type bool = true | false

type none

fn f(n: u32) u32 {
    return match n {
        u32 => 1
        else => 2
    }
}

fn noop() {}

fn g() u32 {
    return match noop() {
        else => 2
    }
}

fn h(r: u32 | none) u32 {
    if r is u32 {
        match r {
            u32 => return r
        }
    }
    return 0
}
