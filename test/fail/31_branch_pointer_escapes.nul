use std.mem.Arena

let Box = struct {
    item: *i64
}

/// On one path 'p' lives in 'arena' and on the other in 'scratch', so after the
/// join it is judged as the shorter lived of the two, and storing it into memory
/// that outlives 'scratch' is rejected.
fn stash(arena: Arena, pick: bool) *Box {
    var scratch = arena.child()

    var p = arena.create(i64)
    if pick {
        p = scratch.create(i64)
    }

    var box = arena.create(Box)
    box.item = p

    return box
}
