error: 'sample' does not live long enough

   ┌─ test/fail/04_escape_borrowed_param.nul:15:16
   │
12 │ fn remember(arena: Arena, sample: *Reading) *Cache {
   │                           ──────  'sample' is borrowed for this call only
13 │     var c = arena.create(Cache)
   │         ─  'c' lives in 'arena'
   ·
15 │     c.latest = sample
   │     ────────   ^^^^^^  this pointer belongs to the caller
   │     │
   │     this memory lives in 'arena'
   ·
17 │     return c
   │            ─  'c' escapes here, still holding 'sample'
