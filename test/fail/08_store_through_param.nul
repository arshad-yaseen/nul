use std.mem.Arena

let Slot = struct {
    held: *i64
}

/// Writing through 'slot' means the caller guarantees it outlives 'arena'. A
/// child of 'arena' dies first, so it cannot be stored there.
fn fill(arena: Arena, slot: *var Slot) {
    var scratch = arena.child()

    var temp = scratch.create(i64)

    slot.held = temp
}
