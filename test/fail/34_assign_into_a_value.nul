use std.mem.Arena

let Point = struct { x: i64 }

/// A parameter arrives as a copy, so writing its field would change something the
/// caller never sees. The same for a 'let' bound to a value.
fn scale(arena: Arena, p: Point) i64 {
    p.x = p.x * 2

    let q = arena.copy(p)
    q.x = 5

    return q.x
}
