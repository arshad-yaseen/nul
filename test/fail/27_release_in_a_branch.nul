use std.mem.Arena

let Item = struct {
    weight: i64
}

/// The release happens in one arm, and the read after the join. No single line is
/// wrong on its own, so the report has to name the path.
fn weigh(arena: Arena, early: bool) i64 {
    var scratch = arena.child()

    var item = scratch.create(Item)
    item.weight = 42

    if early {
        scratch.reset()
    }

    return item.weight
}
