use std.mem.Arena

let Box = struct {
    item: *i64
}

/// After the join 'p' may point into either sibling, and siblings cannot be
/// ordered, so no store into longer lived memory can be right on both paths.
fn stash(arena: Arena, pick: bool) {
    var s1 = arena.child()
    var s2 = arena.child()

    var p = s1.create(i64)
    if pick {
        p = s2.create(i64)
    }

    var box = arena.create(Box)
    box.item = p
}
