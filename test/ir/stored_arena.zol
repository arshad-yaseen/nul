use std.mem.Arena

struct Entry {
    value: i64
    next: ?*var Entry
}

struct List {
    arena: Arena
    first: ?*var Entry

    fn push(self: *var List, value: i64) *var Entry {
        var entry = self.arena.create[Entry]()
        entry.value = value
        entry.next = self.first
        self.first = entry
        return entry
    }
}

fn build(arena: Arena) i64 {
    var list: List = .{ arena: arena, first: null }
    _ = list.push(1)
    let top = list.push(2)
    return top.value
}
