use std.mem.Arena

fn tidy(arena: Arena, early: bool) !i64 {
    var scratch = arena.child()
    defer scratch.reset()
    if early {
        return 1
    }
    let value = try risky(5)
    return value
}

fn risky(seed: i64) !i64 {
    if seed > 4 {
        return error.TooRisky
    }
    return seed
}

fn each_iteration(arena: Arena, rounds: i64) i64 {
    var outer = arena.child()
    var round: i64 = 0
    var kept: i64 = 0
    while round < rounds {
        defer outer.reset()
        round = round + 1
        if round == 2 {
            continue
        }
        if round == 4 {
            break
        }
        kept = kept + round
    }
    return kept
}
