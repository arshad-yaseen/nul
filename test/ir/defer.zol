error TooRisky

struct Counter {
    hits: i64

    fn bump(self: *var Counter) {
        self.hits = self.hits + 1
    }
}

fn tidy(early: bool) !i64 {
    var counter: Counter = .{ hits: 0 }
    defer counter.bump()
    if early {
        return 1
    }
    let value = try risky(5)
    return value
}

fn risky(seed: i64) !i64 {
    if seed > 4 {
        return TooRisky
    }
    return seed
}

fn each_iteration(rounds: i64) i64 {
    var counter: Counter = .{ hits: 0 }
    var round: i64 = 0
    var kept: i64 = 0
    while round < rounds {
        defer counter.bump()
        round = round + 1
        if round == 2 {
            continue
        }
        if round == 4 {
            break
        }
        kept = kept + round
    }
    return kept
}
