fn fallback(maybe: ?i64) i64 {
    return maybe orelse 0
}

fn guarded(maybe: ?i64) i64 {
    let value = maybe orelse {
        return -1
    }
    return value
}

fn tested(maybe: ?i64) i64 {
    if maybe |value| {
        return value * 2
    } else {
        return 0
    }
}

struct Cell {
    value: i64
    next: ?*var Cell
}

fn drain(first: ?*var Cell) i64 {
    var total: i64 = 0
    var cursor = first
    while cursor |cell| {
        total = total + cell.value
        cursor = cell.next
    }
    return total
}
