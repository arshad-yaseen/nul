use std.mem.Arena

let Slot = struct {
    held: *i64
}

/// The counterpart to fail/08. Writing through 'slot' means the caller proved it
/// outlives 'arena', so memory from 'arena' itself may be stored into it.
fn fill(arena: Arena, slot: *var Slot) {
    var value = arena.create(i64)

    slot.held = value
}
