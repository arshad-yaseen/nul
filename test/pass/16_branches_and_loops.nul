use std.mem.Arena

/// Every path returns, arms join, and a loop counts. The plain shapes of control
/// flow, all of which have to check clean.
fn classify(n: i64) i64 {
    if n < 0 {
        return 0 - 1
    } else if n == 0 {
        return 0
    }
    return 1
}

fn sum_to(limit: i64) i64 {
    var total: i64 = 0
    var at: i64 = 0
    for at < limit {
        at = at + 1
        if at == 4 {
            continue
        }
        total = total + at
        if total > 100 {
            break
        }
    }
    return total
}

fn spin() i64 {
    var n: i64 = 0
    for {
        n = n + 1
        if n > 3 {
            break
        }
    }
    return n
}
