use std.mem.Arena

let Handle = struct {
    slot: i64
}

/// An index is a plain number, not an access path, so it crosses arenas freely.
/// This is how the model expects relationships that outlive an arena to be kept.
fn remember(arena: Arena, position: i64) *Handle {
    var scratch = arena.child()

    var staging = scratch.create(Handle)
    staging.slot = position

    var kept = arena.create(Handle)
    kept.slot = staging.slot

    return kept
}
