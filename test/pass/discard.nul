// What '_ =' drops, and what it does not. A value goes away on purpose; a
// failure has to be handled first, and 'catch {}' is how it is dropped.

fn noisy() !i64 {
    return 5
}

fn quiet() i64 {
    return 5
}

fn drive() {
    _ = noisy() catch 0
    noisy() catch {}
    _ = quiet()
    _ = 5 + 5
    let bound = quiet()
    _ = bound
}

fn passing() !i64 {
    // 'try' leaves a plain value behind, so '_ =' drops it
    _ = try noisy()
    return 0
}
