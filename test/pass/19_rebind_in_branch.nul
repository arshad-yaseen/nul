use std.mem.Arena

let Ref = struct {
    target: *i64
}

/// After the join 'p' may live in 'arena' or in 'scratch', so it is judged as the
/// shorter lived of the two. Storing it into scratch memory asks nothing more than
/// scratch itself would, so this is fine on both paths.
fn juggle(arena: Arena, pick: bool) {
    var scratch = arena.child()

    var p = arena.create(i64)
    if pick {
        p = scratch.create(i64)
    }

    var holder = scratch.create(Ref)
    holder.target = p
}
