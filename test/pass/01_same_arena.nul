use std.mem.Arena

let Node = struct {
    value: i64
    next:  *Node
}

/// Pointers between values in one arena need no checking at all. Everything in
/// an arena dies at the same instant, so there is no ordering to get wrong.
fn link(arena: Arena) *Node {
    var a = arena.create(Node)
    var b = arena.create(Node)

    a.value = 1
    b.value = 2
    a.next = b

    return a
}
