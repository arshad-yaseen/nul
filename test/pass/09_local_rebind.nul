use std.mem.Arena

/// A local name may point anywhere. Only values stored into memory are checked,
/// so rebinding a local to scratch and back again is not interesting.
fn juggle(arena: Arena) i64 {
    var scratch = arena.child()

    var p = arena.create(i64)
    p = scratch.create(i64)
    p = arena.create(i64)

    return 0
}
