/// 'and' and 'or' evaluate their right side only when the left leaves the question
/// open, as conditions and as values alike.
fn gate(a: bool, b: bool, n: i64) bool {
    let both = a and n > 0
    var either = b or both

    if both and either {
        either = false
    }
    if a or b or n == 0 {
        return either
    }
    return both or either
}
