fn refuse(over: i64) !i64 {
    if over > 100 {
        return error.TooMuch
    }
    return over
}

fn propagate(seed: i64) !i64 {
    let value = try refuse(seed)
    return value + 1
}

fn supplied(seed: i64) i64 {
    return refuse(seed) catch 0
}

fn inspected(seed: i64) i64 {
    return refuse(seed) catch |err| {
        if err == error.TooMuch {
            return 100
        }
        return -1
    }
}

fn handled(seed: i64) {
    _ = refuse(seed) catch {
        return
    }
}

fn shrugged(seed: i64) {
    _ = refuse(seed) catch report_and_zero()
}

fn report_and_zero() i64 {
    return 0
}

// '!?T' is the nesting that means something, so it is the one '?!T' points at.
// Reaching it takes two wraps, and every arm below writes a different one.
fn lookup(id: i64) !?i64 {
    if id < 0 {
        return error.TooMuch
    }
    if id == 0 {
        return null
    }
    return id
}

fn resolved(id: i64) i64 {
    let found = lookup(id) catch {
        return -1
    }
    return found orelse 0
}
