// The four rules, checked. An 'if' is an expression, a block in value
// position is worth its tail, the ways out never produce a value, and a
// statement is the case where nobody wants one.

struct Cell {
    value: i64
}

fn expression_body(a: i64, b: i64) i64 = if a > b { a } else { b }

fn tail_of_a_block(c: bool) i64 {
    let n: i64 = if c {
        let base: i64 = 8000
        base + 80
    } else {
        0
    }
    return n
}

fn one_arm_leaves(c: bool) i64 {
    let n: i64 = if c { 1 } else { return 0 }
    return n
}

fn both_arms_leave(c: bool) i64 {
    if c { return 1 } else { return 2 }
}

fn through_a_capture(opt: ?i64) i64 {
    let n: i64 = if opt |value| { value * 2 } else { 0 }
    return n
}

fn guard(opt: ?i64) i64 {
    let value = opt orelse return 0
    return value
}

fn rescue(may: !i64) i64 {
    let value = may catch return -1
    return value
}

fn fallback_with_a_tail(may: !i64) i64 {
    let value = may catch |err| {
        let backup: i64 = 8080
        backup
    }
    return value
}

fn statement_position(c: bool, out: *var Cell) {
    if c {
        out.value = 1
    } else {
        out.value = 2
    }
}

fn dropped(may: !i64) {
    // 'catch' settles the failure, '_ =' settles the value. two drops, two marks
    _ = may catch 0
}

fn leaves_a_loop(limit: i64, opt: ?i64) i64 {
    var total: i64 = 0
    var i: i64 = 0
    while i < limit {
        // the counter advances first, so 'continue' still makes progress
        i = i + 1
        let step = opt orelse break
        if i == 3 { continue }
        total = total + step * i
    }
    return total
}

fn as_an_argument(c: bool) i64 {
    return take(if c { 1 } else { 2 })
}

fn take(n: i64) i64 {
    return n
}

fn annotated_null(c: bool) ?i64 {
    // the context names the type, so a bare null in an arm is fine
    let x: ?i64 = if c { null } else { 5 }
    return x
}

fn every_arm_leaves(a: bool, b: bool) i64 {
    // the inner 'if' produces no value on any path, so the outer one takes its
    // type from the else arm and the inner join is dropped
    let n: i64 = if a {
        if b { return 1 } else { return 2 }
    } else {
        3
    }
    return n
}

fn leaving_from_an_operand(a: i64, opt: ?i64) i64 {
    let n = (opt orelse return 0) + 1
    return n + a
}

fn operand_that_never_arrives(a: i64, c: bool) i64 {
    // every path through the operand leaves, so the addition never happens
    return a + (if c { return 1 } else { return 2 })
}
