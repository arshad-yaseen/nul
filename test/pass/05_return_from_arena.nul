use std.mem.Arena

let Point = struct {
    x: i64
    y: i64
}

/// A function allocates results into its one arena parameter, so the region of
/// the return value is unambiguous without anyone writing it down.
fn origin(arena: Arena) *Point {
    var p = arena.create(Point)

    p.x = 0
    p.y = 0

    return p
}
