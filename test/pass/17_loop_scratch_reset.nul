use std.mem.Arena

let Item = struct {
    weight: i64
}

/// The canonical scratch loop: temporaries live for one iteration, the reset ends
/// them, and the next iteration's allocations are new values, made after it. The
/// checker must see that the release never reaches a use of the same making.
fn process(arena: Arena, rounds: i64) i64 {
    var scratch = arena.child()
    var total: i64 = 0
    var at: i64 = 0

    for at < rounds {
        var item = scratch.create(Item)
        item.weight = at * 2
        total = total + item.weight

        scratch.reset()
        at = at + 1
    }

    return total
}
