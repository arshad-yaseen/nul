struct Pair {
    a: i64
    b: bool
}

fn maybe(n: i64) ?i64 {
    if n > 0 {
        return n
    }
    return null
}

fn risky(n: i64) !i64 {
    if n < 0 {
        return error.Negative
    }
    return n
}

pub fn main() i64 {
    let p: Pair = .{ a: 20, b: true }
    let m = maybe(5) orelse 0
    let r = risky(3) catch 0
    return p.a + m + r
}

fn diverging_operand(a: i64, c: bool) i64 {
    // every path through the operand leaves, so the slot the 'if' reserved is
    // storage nothing writes. the backend still has to be able to name it
    return a + (if c { return 1 } else { return 2 })
}
