struct Header {
    tag: i64
}

struct Payload {
    value: i64
    extra: i64
}

fn reinterpret(header: *var Header) *var Payload {
    return intrinsic.ptr_cast[Payload](header)
}

fn keeps_read_only(header: *Header) *Payload {
    return intrinsic.ptr_cast[Payload](header)
}

fn through_a_field(header: *var Header) i64 {
    let payload = intrinsic.ptr_cast[Payload](header)
    payload.value = 1
    return payload.extra
}
